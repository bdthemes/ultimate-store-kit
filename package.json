{
  "name": "ultimate-store-kit",
  "version": "3.1.2",
  "main": "index.php",
  "files": [
    "assets",
    "base",
    "includes",
    "!includes/Admin/assets/js",
    "!includes/Admin/assets/css",
    "languages",
    "modules",
    "src",
    "templates",
    "traits",
    "vendor",
    "composer.json",
    "postcss.config.js",
    "tailwind.config.js",
    "webpack.config.js",
    "*.php"
  ],
  "scripts": {
    "start": "wp-scripts start",
    "build": "wp-scripts build",
    "clean": "rimraf ./assets && rimraf ultimate-store-kit",
    "lint:fix": "eslint \"src/js/**/*.js\" --fix",
    "packages-update": "wp-scripts packages-update",
    "make-pot": "wp i18n make-pot . languages/ultimate-store-kit.pot --exclude=node_modules,vendor,src",
    "plugin-zip": "wp-scripts plugin-zip",
    "publish": "npm run build && npm run make-pot && npm run plugin-zip"
  },
  "keywords": [
    "ultimate-store-kit",
    "theme"
  ],
  "author": "bdthemes",
  "license": "ISC",
  "devDependencies": {
    "@wordpress/scripts": "^33.0.0",
    "tailwindcss": "^3.4.17",
    "webpack-remove-empty-scripts": "^1.1.1"
  }
}
